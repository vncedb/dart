# =========================================
# DART - Production .gitignore
# Expo + React Native + Supabase
# =========================================

# ================================
# Dependencies
# ================================
node_modules/
.pnp/
.pnp.js

# ================================
# Environment Variables (CRITICAL)
# ================================
.env
.env.*
.env.local
.env*.local

# EXCEPTION: Always track the example file for team reference
!.env.example

# ================================
# Expo & React Native
# ================================
.expo/
dist/
web-build/
expo-env.d.ts
build/

# Native folders (Ignored for Expo Continuous Native Generation - CNG)
# Note: Remove these if you run 'npx expo prebuild' and need to manually edit native code.
ios/
android/

# ================================
# Supabase Local Development
# ================================
supabase/.temp/
supabase/.branches/
# Note: Do NOT ignore supabase/migrations/ or supabase/functions/

# ================================
# Native Build Artifacts & Security
# ================================
.kotlin/
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# ================================
# Metro Bundler & Logs
# ================================
.metro-health-check*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
hs_err_pid*

# ================================
# Testing & Coverage
# ================================
coverage/
*.tsbuildinfo
jest.config.js.snap

# ================================
# OS & IDEs (macOS / Windows / VSCode)
# ================================
.DS_Store
.DS_Store?
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp

# ================================
# Misc
# ================================
*.orig.*
app-example/